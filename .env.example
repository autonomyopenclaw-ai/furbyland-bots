# App credentials from the X developer portal (the app owned by @Autonomycc).
# These are the consumer key and secret. They are not a bot account's access token.
X_API_KEY=your_api_key_here
X_API_SECRET=your_api_secret_here

# Access token for @QueenOfFurbies.
# Produced by: python -m furbybots auth --account queen
# The helper also writes these to tokens/queen.env, which is gitignored.
QUEEN_ACCESS_TOKEN=your_queen_access_token_here
QUEEN_ACCESS_TOKEN_SECRET=your_queen_access_token_secret_here

# Optional text provider. If neither key is set, the bot uses bundled posts
# and a template. If both are set, XAI_API_KEY is used.
# XAI_API_KEY=your_xai_api_key_here
# XAI_MODEL=grok-3
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini

# Optional. Defaults are ./tokens and ./data.
# FURBYBOTS_TOKEN_DIR=tokens
# FURBYBOTS_DATA_DIR=data
